{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "1.0.0",
  "identifier": "com.synapse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synapse — Local Evidence Graph",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "shell": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Synapse Authors",
    "shortDescription": "Local-First Research Assistant and Evidence Graph Engine",
    "longDescription": "Synapse is a local-first desktop research assistant that extracts, verifies, and organizes empirical evidence graphs."
  }
}
