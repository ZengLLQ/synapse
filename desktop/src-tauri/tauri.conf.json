{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "1.0.0",
  "identifier": "com.synapse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synapse — Local Evidence Graph",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "shell": {}
  }
}
